# Database (Supabase/Railway/local Postgres)
DATABASE_URL="postgresql://user:pass@localhost:5432/guidebook"

# Auth.js
AUTH_SECRET="generate with: npx auth secret"
EMAIL_SERVER="smtp://user:pass@smtp.example.com:587"   # magic-link sender (Resend/Postmark SMTP works)
EMAIL_FROM="Guidebook <login@yourdomain.com>"

# Twilio
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WEBHOOK_URL="https://yourdomain.com/api/webhooks/twilio"  # must match Twilio console exactly

# NWS requires an identifying User-Agent
NWS_USER_AGENT="guidebook (you@yourdomain.com)"

# Cron protection
CRON_SECRET="any-long-random-string"

# Required on Vercel/any proxy host
AUTH_TRUST_HOST="true"

# Optional: adds a "Try the demo" button to the sign-in page. Each visitor gets a private
# account with sample data (no email needed, texting off, deleted after 7 days).
# DEMO_ENABLED="true"
